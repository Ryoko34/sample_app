<h1>投稿一覧</h1>
<%# eachメソッド 配列やハッシュがもつ要素を順番に取得して実行(表示) %>
<%# @lists.each Listレコードの数だけ繰り返し処理を行う %>

<% @lists.each do |list| %>
  <p>タイトル</p>
  <span>
    <%= link_to list.title, list_path(list.id) %>
  </span>

  <%# link_to 表示させるテキスト, リンク先URL %>
  <%# list_path 名前付きルート('list#show'の設定を、listとして利用できる) %>
  <%# list変数 ブロック変数 %>

<% end %>